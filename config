# i3 config
set $mod Mod1
font pango:monospace 8

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# Autostart
exec --no-startup-id polybar
exec --no-startup-id xrandr --output eDP-1 --scale 0.5x0.5
exec_always --no-startup-id feh --bg-fill /home/cat/Downloads/jon.png
exec_always --no-startup-id xsetroot -cursor_name left_ptr

# --- Core Apps ---
bindsym $mod+t exec alacritty
bindsym $mod+d exec rofi -show drun
bindsym $mod+e exec thunar
bindsym $mod+b exec thorium-browser --password-store=basic
bindsym $mod+s exec sh -c "maim -s | xclip -selection clipboard -t image/png"
bindsym $mod+g exec thorium-browser --app="https://gemini.google.com"
# --- Window Management ---
bindsym $mod+q kill
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+h focus left
bindsym $mod+l focus right

# Moving windows
bindsym $mod+Shift+j exec i3lock -i /home/cat/Downloads/suguru.png
bindsym $mod+Shift+k move up
bindsym $mod+Shift+h move left
bindsym $mod+Shift+l move right

# Resizing (dwm style mfact feel)
bindsym $mod+Control+h resize shrink width 5 px or 5 ppt
bindsym $mod+Control+l resize grow width 5 px or 5 ppt

# --- Layouts ---
bindsym $mod+Shift+t layout tiling
bindsym $mod+f layout floating
bindsym $mod+m layout tabbed
bindsym $mod+space layout toggle all
bindsym $mod+Shift+space floating toggle
bindsym $mod+Return zoom

# --- Workspaces ---
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9

# --- System Control ---
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+q exec i3-msg exit
bindsym $mod+Shift+s exec shutdown now

# --- Visuals & Bar ---
# No gaps, no borders for a clean look
default_border pixel 1
default_floating_border pixel 1
smart_borders on

bar {
	mode hide
	hidden_state hide
    }


# This reserves space at the top so windows don't cover the bar
for_window [class="Polybar"] floating enable, border none
